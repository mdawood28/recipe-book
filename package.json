{
    "name": "recipe-book",
    "version": "1.0.0",
    "description": "Premium Recipe Book Website",
    "main": "app.js",
    "scripts": {
        "start": "node app.js",
        "dev": "concurrently \"nodemon app.js\" \"npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --watch\"",
        "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/style.css --minify"
    },
    "dependencies": {
        "ejs": "^3.1.9",
        "express": "^4.18.2"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "nodemon": "^3.0.1",
        "tailwindcss": "^3.3.5"
    }
}